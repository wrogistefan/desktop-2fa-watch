<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Only Android's signature-permission-protected IME manager may bind. -->
        <service android:name=".testing.SyntheticFullscreenIme"
            android:label="Synthetic test keyboard" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/synthetic_input_method" />
        </service>
        <!-- Instrumentation-only crash fixture host. Absent from release builds.
             This private process is dedicated to this component; no other host should join it. -->
        <activity android:name=".testing.SyntheticRecoveryProcessActivity"
            android:exported="false" android:process=":synthetic_recovery" />
        <activity android:name=".testing.SyntheticMainActivity"
            android:exported="false" android:windowSoftInputMode="adjustResize" />
        <!-- Dedicated disposable process; the test controller kills it before cleanup. -->
        <activity android:name=".testing.SyntheticSessionProcessActivity"
            android:exported="false" android:process=":synthetic_session" />
    </application>
</manifest>
